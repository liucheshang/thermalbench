# 行尾与编码保护（Windows 中文项目专用）
# 目标：任何人 clone 下来，.bat 都能双击直接跑，图片不被 git 弄坏。

# Windows 批处理必须保持 CRLF + GBK，绝不让 git 做任何转换
*.bat  -text
*.cmd  -text

# 图片按二进制处理
*.png  binary
*.jpg  binary
*.svg  text eol=lf

# 源码与文档统一 LF
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.csv  text

# 示例数据不动
examples/* -text
